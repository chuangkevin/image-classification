# 複製成 /volume1/docker/image-classification/backup.env 再改成自己的值（這個檔不進版控）。
# 目的地帳號：用 SSH 金鑰登入，建議在目的地 authorized_keys 加 from= 與 no-pty 限制。
BACKUP_USER=photo-backup
# 目的地照片根目錄，底下會建立「品牌/型號/日期」
BACKUP_DEST="/volume1/photo/Camera"
# 依序嘗試的主機（例如先區網 IP，再 Tailscale IP）
BACKUP_HOSTS="192.168.1.20 nas-backup"
# 可選：來源目錄與金鑰
#BACKUP_SRC=/volume1/photo/ImageClassification
#BACKUP_KEY=/volume1/docker/image-classification/backup_ed25519
